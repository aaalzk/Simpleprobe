# Server configuration for Simpleprobe (简易探针)
listen: ":8080"                  # Listen address
db_path: "./probe.db"            # SQLite database path
token: "change-me"               # Shared secret — MUST CHANGE! Use: openssl rand -hex 32

# Gotify notification settings
gotify:
  url: "https://gotify.example.com"
  token: "your-gotify-app-token"

# Alert thresholds
alerts:
  offline_seconds: 90            # Mark offline after this many seconds without report
  cpu_threshold: 90              # Alert when CPU% exceeds this value
  traffic_rx_mbps: 800           # Alert when Rx traffic (Mbps) exceeds this value
  traffic_tx_mbps: 800           # Alert when Tx traffic (Mbps) exceeds this value
  cooldown_seconds: 300          # Minimum seconds between same-type alerts per server
  tolerance:                     # Consecutive triggers before alerting (per type)
    offline: 3                   # Offline alert after 3 consecutive offline detections
    cpu: 3                       # CPU alert after 3 consecutive threshold crossings
    traffic_rx: 3                # Inbound traffic alert after 3 consecutive crossings
    traffic_tx: 3                # Outbound traffic alert after 3 consecutive crossings
    site_down: 3                 # Site down alert after 3 consecutive failures
    site_up: 3                   # Site recovery alert after 3 consecutive successes

history_retention_hours: 72      # How long to keep historical data

# Site availability monitoring (站点可用性监控)
# Server probes each site's HTTP(S) status code periodically, records history,
# and shows 24h uptime on the dashboard. Failures/recoveries raise Gotify alerts.
sites:
  - name: "example"              # Display name, must be unique
    url: "https://example.com"   # Full URL to probe
    # interval: 60               # Probe interval in seconds (default 60)
    # timeout: 10                # Request timeout in seconds (default 10)